visibility_course_admins#:#Course administrators + system administrators
visibility_course_admins_info#:#Course administrators, test owners and system administrators can see the tab.
visibility_specific_users#:#Selected users only + system administrators
visibility_specific_users_info#:#Only explicitly listed users and system administrators see the tab. As usual, an edit permission on the individual test is required in addition — the list is not a cross-test permission.
examalert_auto_section#:#ExamAlert auto-activation
examalert_auto_label#:#Default for new tests
examalert_auto_info#:#This setting only affects new tests. Existing tests keep their current settings. Administrators can activate or deactivate ExamAlert manually in the test settings at any time.
examalert_auto_on#:#Enabled: every new test automatically has ExamAlert activated (30s warning before the end)
examalert_auto_on_info#:#New tests automatically receive a 30-second warning before the test ends.
examalert_auto_off#:#Disabled: ExamAlert must be activated manually in the settings for each test
examalert_auto_off_info#:#ExamAlert is disabled by default for new tests.
